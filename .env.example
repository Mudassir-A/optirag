GROQ_API_KEY=

OPTIRAG_PROVIDER=groq
OPTIRAG_SMALL_MODEL=openai/gpt-oss-20b
OPTIRAG_LARGE_MODEL=openai/gpt-oss-120b
OPTIRAG_JUDGE_MODEL=openai/gpt-oss-120b
OPTIRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPTIRAG_REASONING_EFFORT=low

OPTIRAG_CORPUS_DIR=data/corpus
OPTIRAG_CHUNK_WORDS=400
OPTIRAG_CHUNK_OVERLAP=60
OPTIRAG_RETRIEVAL_K=3

OPTIRAG_CACHE_THRESHOLD=0.90
OPTIRAG_CACHE_TTL_HOURS=168

OPTIRAG_ROUTER_MODE=rules
OPTIRAG_ROUTER_THRESHOLD=2.0
OPTIRAG_ESCALATE_BELOW=0.5
