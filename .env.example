# Required 
GROQ_API_KEY=your_groq_api_key_here

# Document 
OPTIRAG_PDF_PATH=data/document.pdf

# Models (Groq) 
OPTIRAG_SMALL_MODEL=openai/gpt-oss-20b
OPTIRAG_LARGE_MODEL=openai/gpt-oss-120b
OPTIRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Semantic cache 
OPTIRAG_CACHE_THRESHOLD=0.90
OPTIRAG_CACHE_TTL_HOURS=168

# Routing 
OPTIRAG_ROUTER_THRESHOLD=2.0

# Retrieval 
OPTIRAG_RETRIEVAL_K=3